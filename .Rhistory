fusk,           # ExpressionSet
randomForestI,  # random forest interface
1:40            # features to use
)
# Show model summary
rfALL
# Confusion matrix for Random Forest
cm_rfALL <- confuMat(rfALL)
cm_rfALL
# Accuracy of Random Forest
acc_rfALL <- sum(diag(cm_rfALL)) / sum(cm_rfALL)
cat("Accuracy:", sprintf("%.2f%%", acc_rfALL * 100))
# Load the Golub data and subset to B-cell lineage and ALL patients
data(Golub_Merge)
golub <- Golub_Merge
golub_bALL <- golub[ ,
pData(golub)$T.B.cell == "B-cell" & pData(golub)$ALL.AML == "ALL"
]
# 1) Map ALL probes and Golub probes to SYMBOL
all_map   <- AnnotationDbi::select(hgu95av2.db,
keys = featureNames(fusk),
columns = c("PROBEID","SYMBOL"), keytype = "PROBEID")
golub_map <- AnnotationDbi::select(hu6800.db,
keys = featureNames(golub_bALL),
columns = c("PROBEID","SYMBOL"), keytype = "PROBEID")
# 2) Find common gene symbols
common_symbols <- intersect(golub_map$SYMBOL, all_map$SYMBOL)
# 3) Pick one representative probe per symbol
probe_golub <- golub_map %>% filter(SYMBOL %in% common_symbols) %>% group_by(SYMBOL) %>% dplyr::slice(1)
probe_all <- all_map %>% filter(SYMBOL %in% common_symbols)   %>% group_by(SYMBOL) %>% dplyr::slice(1)
common_probes <- probe_all$PROBEID
# 4) Build aligned matrices
train_mat <- t(exprs(fusk)[probe_all$PROBEID, ])
test_mat  <- t(exprs(golub_bALL)[probe_golub$PROBEID, ])
colnames(train_mat) <- probe_all$SYMBOL
colnames(test_mat)  <- probe_golub$SYMBOL
# 5) Predict with random forest model
rf_model   <- rfALL$fit
golub_pred <- predict(rf_model, as.data.frame(test_mat))
# 6) Show predicted counts
table(golub_pred)
################################################################################
fusk_common <- fusk[common_probes,]
