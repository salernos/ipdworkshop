hgu6800.db,
keys    = featureNames(Golub_Merge),
columns = c("PROBEID","SYMBOL"),
keytype = "PROBEID"
)
# 3.3 Identify common symbols
common_sym <- intersect(gmap_all$SYMBOL, gmap_golub$SYMBOL)
# 3.4 For each symbol, pick the first associated probe
probe_all   <- gmap_all   %>% filter(SYMBOL %in% common_sym) %>% group_by(SYMBOL) %>% slice(1)
probe_golub <- gmap_golub %>% filter(SYMBOL %in% common_sym) %>% group_by(SYMBOL) %>% slice(1)
# 3.5 Subset ExpressionSets to these probes
dat_train  <- dat_filt[probe_all$PROBEID, ]
eset_golub <- Golub_Merge[probe_golub$PROBEID, ]
# 3.6 Further subset Golub to B-cell ALL samples
golub_BALL <- eset_golub[, pData(eset_golub)$T.B.cell == "B" & pData(eset_golub)$ALL.AML == "ALL"]
